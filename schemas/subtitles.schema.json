{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subtitles.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "display_cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "source_text": {
            "type": "string"
          },
          "translation": {
            "type": "string"
          },
          "sentence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "linguistic_occurrence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "translation_alignment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "sequence",
          "start",
          "end",
          "source_text",
          "translation",
          "sentence_ids",
          "linguistic_occurrence_ids"
        ],
        "additionalProperties": true
      }
    },
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "translation": {
            "type": "string"
          },
          "cue_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cue_end_times": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "concept_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "text",
          "translation",
          "cue_ids",
          "cue_end_times",
          "concept_ids"
        ],
        "additionalProperties": true
      }
    },
    "linguistic_occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "occurrence_id": {
            "type": "string"
          },
          "instance_id": {
            "type": "string"
          },
          "concept_id": {
            "type": "string"
          },
          "cue_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "start_char": {
            "type": "integer",
            "minimum": 0
          },
          "end_char": {
            "type": "integer",
            "minimum": 1
          },
          "sentence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "occurrence_id",
          "instance_id",
          "concept_id",
          "cue_id",
          "text",
          "start_char",
          "end_char",
          "sentence_ids"
        ],
        "additionalProperties": true
      }
    },
    "translation_alignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alignment_id": {"type": "string"},
          "occurrence_id": {"type": "string"},
          "cue_id": {"type": "string"},
          "text": {"type": "string"},
          "start_char": {"type": "integer", "minimum": 0},
          "end_char": {"type": "integer", "minimum": 1},
          "alignment_type": {"type": "string", "enum": ["direct", "paraphrase", "split"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "required": ["alignment_id", "occurrence_id", "cue_id", "text", "start_char", "end_char", "alignment_type", "confidence"],
        "additionalProperties": true
      }
    },
    "annotation_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
          "concept_id": {
            "type": "string"
          },
          "sentence_id": {
            "type": "string"
          },
          "surface_form": {
            "type": "string"
          },
          "cue_id": {
            "type": "string"
          },
          "start_char": {
            "type": "integer",
            "minimum": 0
          },
          "end_char": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": true
      }
    },
    "translation_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {"type": "string"},
          "cue_id": {"type": "string"},
          "unmatched_tokens": {"type": "array", "items": {"type": "string"}},
          "translation": {"type": "string"},
          "sentence_translation": {"type": "string"}
        },
        "required": ["reason", "cue_id"],
        "additionalProperties": true
      }
    },
    "translation_alignment_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {"type": "string"},
          "occurrence_id": {"type": "string"},
          "cue_id": {"type": "string"}
        },
        "required": ["reason"],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema_version",
    "display_cues",
    "sentences",
    "linguistic_occurrences",
    "annotation_warnings"
  ],
  "additionalProperties": true
}
