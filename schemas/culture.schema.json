{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "culture.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sentence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trigger_time": {
            "type": "number",
            "minimum": 0
          },
          "topic": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "needs_review": {"type": "boolean"},
          "verification_note": {"type": "string"}
        },
        "required": [
          "id",
          "sentence_ids",
          "trigger_time",
          "topic",
          "explanation",
          "confidence"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema_version",
    "items"
  ],
  "additionalProperties": true
}
