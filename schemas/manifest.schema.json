{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "content_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "video": {
      "type": "object"
    },
    "source_language": {
      "type": "string"
    },
    "target_language": {
      "type": "string"
    },
    "assessment_interval_seconds": {
      "type": "number"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "content_id",
    "title",
    "video",
    "source_language",
    "target_language",
    "assessment_interval_seconds",
    "files"
  ],
  "additionalProperties": true
}
